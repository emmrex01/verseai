# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=support@yourdomain.com

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server + worker only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=
# Optional model overrides
# AI_FAST_MODEL=claude-haiku-4-5
# AI_REASONING_MODEL=claude-opus-5-5

# --- Stripe (Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUTHOR_MONTHLY=
STRIPE_PRICE_AUTHOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# --- Admin dashboard (/app/admin): comma-separated emails ---
ADMIN_EMAILS=

# --- Free checker abuse controls ---
# Any long random string; used to hash visitor IPs for rate limiting.
IP_HASH_SALT=
# Max USD of model spend per 24h across all free-checker runs.
FREE_TOOL_DAILY_BUDGET_USD=10
